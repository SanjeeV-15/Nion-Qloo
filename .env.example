# Copy this file to .env and fill in your own values. Never put a real key in this file.
ANTHROPIC_API_KEY=
# Qloo hackathon key (works only with https://hackathon.api.qloo.com)
QLOO_API_KEY=

# ----- Optional settings (the defaults are fine for trying Nion on your own computer) -----
# Which Claude model answers. Haiku 5.5 is cheap and quick.
# NION_MODEL=claude-haiku-5-5

# Protecting your credit when Nion is online for anyone to use. An estimate of what the demo may spend:
# NION_DAILY_BUDGET_USD=2
# NION_TOTAL_BUDGET_USD=8
# Questions one visitor may ask, per minute and per hour, and how many may be answered at once:
# NION_VISITOR_PER_MINUTE=6
# NION_VISITOR_PER_HOUR=40
# NION_MAX_IN_FLIGHT=6
# A looser limit per network address (per hour), in case someone calls the server directly:
# NION_IP_PER_HOUR=300
# Stop asking Qloo (and say Nion is resting) when this few of its 10,000 monthly calls are left:
# NION_QLOO_RESERVE=150

# On a host with proxies in front (like Render): how many to trust when reading a visitor's address.
# TRUST_PROXY_HOPS=1
# Set to 1 for a moment to see /api/whoami, to work out the number above. Turn it off afterwards.
# NION_IP_DEBUG=1

# Look up the demo's few likely items a moment after starting, so the first visitor's question is quicker.
# Set to 0 to turn it off (the tests do).
# NION_WARMUP=1
